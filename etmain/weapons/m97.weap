weaponDef
{
	// This basically fills out weaponInfo_t
	client {
		scaleFirstPerson	.85
		standModel			"models/weapons2/m97/m97_3rd.md3"	// weapon pickup 'stand' (do we still use this?)
		pickupModel			"models/weapons2/m97/m97_pickup.md3"
		//pickupSound		"sound/misc/w_pkup.wav"

		weaponConfig		"models/weapons2/m97/weapon.cfg"
		handsModel			"models/weapons2/m97/v_m97_hand.md3"

		flashDlightColor	1.0 0.6 0.23
		flashSound			"sound/weapons/m97/shotgun_fire.wav"		// supports up to 4 flash sounds
		flashEchoSound		"sound/weapons/m97/shotgun_far.wav"		// supports up to 4 flash echo sounds
		lastShotSound		"sound/weapons/m97/shotgun_fire_last.wav"										// supports up to 4 last shot sounds

		//readySound		""
		//firingSound		""									// no weapons seem to use this, basically it's a replacement hum for readysound, but then when firing
		//overheatSound		""
		reloadSound			"sound/weapons/m97/shotgun_reload.wav"
		reloadFastSound		"sound/weapons/m97/shotgun_reloadpump.wav"		// some weapons have fast reloads due to the skill system
		//spinupSound		""									// sound started when fire button goes down, and stepped on when the first fire event happens
		//spindownSound		""									// sound called if the above is running but player doesn't follow through and fire
		//switchSound		""									// allow overriding of weaponswitch sound
		noAmmoSound         "sound/weapons/misc/fire_dry.wav"

		weaponIcon			"models/weapons2/m97/icon.tga"
		weaponIconScale		2
		weaponSelectedIcon	"models/weapons2/m97/icon.tga"
		weaponSimpleIcon	"simpleicons/thompson"
		weaponSimpleIconScale 2 1

		weaponCardIcon      "models/weapons2/m97/card.tga"
		weaponCardScale     1 1
		weaponCardPointS    0 1
		weaponCardPointT    0 1

		//missileModel		""
		//missileSound		""
		//missileTrailFunc	""									// supports "GrenadeTrail", "RocketTrail", "PyroSmokeTrail" and "DynamiteTrail" (we REALLY want a particle system for this)
		//missileDlight		0
		//missileDlightColor	0 0 0							// do we still use this?

		ejectBrassFunc		"MachineGunEjectBrass"				// supports "MachineGunEjectBrass" and "PanzerFaustEjectBrass"

		fireRecoil 2 1 0    // kick angle
		adjustLean 1 1 1

		impactDurationCoeff 1
		impactMarkMaxRange  384	// -1 infinite
		impactParticle    "particles/bullet.particle"
		impactSoundVolume 64
		impactMarkRadius  1.5
		// each surface supports up to 5 hits sounds. available surface : default, far, wood, metal, roof, gravel, glass, snow, water, flesh
		impactSound {
			default 5 "sound/weapons/impact/stone"
			wood    5 "sound/weapons/impact/wood"
			metal   5 "sound/weapons/impact/metal"
			roof    5 "sound/weapons/impact/metal"
			glass   5 "sound/weapons/impact/glass"
			water   5 "sound/weapons/impact/water"
			//flesh   5 "sound/weapons/impact/flesh"    // terrible sounds, stonehit is used instead
		}
		// each surface supports up to 1 marks shader. available surface : default, far, wood, metal, roof, gravel, glass, snow, water, flesh
		impactMark {
			default "gfx/damage/bullet_mrk"
			wood    "gfx/damage/wood_mrk"
			metal   "gfx/damage/metal_mrk"
			glass   "gfx/damage/glass_mrk"
		}

		//modModel 1		""

		firstPerson {
			model			"models/weapons2/m97/v_m97.md3"
			flashModel		"models/weapons2/mp40/v_mp40_flash.mdc"
			flashScale 0.5

			// weapon building
			weaponLink
			{
				part 0
				{
					tag		"tag_slide"
					model	"models/weapons2/m97/v_m97_slide.md3"
				}
				part 1
				{
					tag		"tag_carrier"
					model	"models/weapons2/m97/v_m97_carrier.md3"
				}
				part 2
				{
					tag		"tag_shell"
					model	"models/weapons2/m97/v_m97_shell.md3"
				}
				part 3
				{
					tag		"tag_bolt"
					model	"models/weapons2/m97/v_m97_bolt.md3"
				}
				part 4
				{
					tag		"tag_hammer"
					model	"models/weapons2/m97/v_m97_hammer.md3"
				}
				part 5
				{
					tag		"tag_sleeve"
					model	"models/weapons2/m97/v_m97_sleeve.md3"
				}
				part 6
				{
					tag		"tag_shell2"
					model	"models/weapons2/m97/v_m97_shell2.md3"
				}
				part 7
				{
					tag		"tag_arm"
					model	"models/weapons2/m97/v_m97_larm.md3"
					axisskin	"models/weapons2/m97/m97_axis.skin"
					alliedskin	"models/weapons2/m97/m97_allied.skin"
				}
			}
		}

		thirdPerson {
			model			"models/weapons2/m97/m97_3rd.md3"
			flashModel		"models/weapons2/mp40/mp40_flash.mdc"
			flashScale 0.9

			ejectBrassOffset	16 -4 24
		}
	}
}
